    "publisher": "11th Kuching Company",
    "homepage": "https://app.11kchbb.workers.dev/",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
