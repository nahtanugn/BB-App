{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "11KCHBB App",
  "version": "1.1.0",
  "identifier": "my.11kchbb.app",
  "build": {
    "frontendDist": "https://app.11kchbb.workers.dev/"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "11KCHBB App",
        "url": "https://app.11kchbb.workers.dev/",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
