{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Allows the BB App setup window to open approved setup and tutorial links in the system browser.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://deploy.workers.cloudflare.com/*"
        },
        {
          "url": "https://github.com/nahtanugn/BB-App/*"
        }
      ]
    }
  ]
}
